# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL + PostGIS)
DB_URL=postgresql+asyncpg://user:password@localhost:5432/kisan_saathi_db

# JWT Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# External APIs
WEATHER_API_KEY=your_openmeteo_or_imd_api_key
MAPS_API_KEY=your_google_maps_or_mapbox_api_key
ML_MODEL_ENDPOINT=http://localhost:8001/predict

# AgriStack
AGRISTACK_UFSI_KEY=your_agristack_ufsi_api_key

# SMS / WhatsApp stubs
SMS_API_KEY=your_sms_api_key
WHATSAPP_TOKEN=your_whatsapp_business_token

# Redis (for Celery background jobs)
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
