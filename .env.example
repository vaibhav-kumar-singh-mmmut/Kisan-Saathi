# Kisan Saathi — Root .env.example
# Copy to .env and fill in REAL values. NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://user:password@localhost:5432/kisan_saathi_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_a_256bit_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External APIs ─────────────────────────────────────────────────────────────
WEATHER_API_KEY=your_openmeteo_or_imd_api_key_here
MAPS_API_KEY=your_google_maps_or_mapbox_api_key_here
ML_MODEL_ENDPOINT=http://localhost:8001/predict

# ── AgriStack (UFSI) ──────────────────────────────────────────────────────────
AGRISTACK_UFSI_KEY=your_agristack_ufsi_key_here

# ── Messaging ─────────────────────────────────────────────────────────────────
SMS_API_KEY=your_sms_api_key
WHATSAPP_TOKEN=your_whatsapp_business_token

# ── Redis (Celery task queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
